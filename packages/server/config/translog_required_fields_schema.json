  "schemas_by_status": {
    "PROCESSING": {
      "description": "Message bắn sau khi ConfirmPay được chấp nhận, đang xử lý bất đồng bộ.",
      "required_fields": [
        "order_no",
        "app_id",
        "app_trans_id",
        "amount",
        "payment_type",
        "dest_asset.dest_asset_type",
        "status",
        "create_time",
        "payment.payment_no",
        "payment.status",
        "payment.source_asset_list.source_assets",
        "payment.metadata.payment_system"
      ],
      "conditional_fields": [
        {
          "field": "payment.authorization",
          "required_when": "order.capture_method = CAPTURE_METHOD_MANUAL",
          "confirm_with_dev": true
        }
      ],
      "must_be_absent_or_empty": [
        "reason_status"
      ]
    },

    "SUCCESS": {
      "description": "Message bắn khi thanh toán hoàn tất thành công.",
      "required_fields": [
        "transID",
        "appID",
        "transType",
        "pmcID",
        "amount",
        "userChargeAmount",
        "userFeeAmount",
        "transStatus",
        "status",
        "systemVersion",
        "authInfo",
        "fsChargeInfo",
        "merchantCategoryCode",
        "productType",
        "paymentMethod",
        "sourceTxnStatus"
      ]
    }
  },

